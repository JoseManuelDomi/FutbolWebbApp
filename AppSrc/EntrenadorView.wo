// C:\DataFlex Projects\FutbolWebbApp\AppSrc\EntrenadorView.wo
// EntrenadorView
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use centrenadorDataDictionary.dd

Object oEntrenadorView is a cWebView
    Set piColumnCount to 12
    Set psCaption to "EntrenadorView"
    Set piWidth to 700

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set DDO_Server To oliga_DD
    End_Object 

    Object oentrenador_DD is a centrenadorDataDictionary
        Set DDO_Server To oequipo_DD
    End_Object 

    Set Main_DD To oentrenador_DD
    Set Server  to oentrenador_DD
    
    Procedure OnShow
    Forward Send OnShow
    Send Request_Find of oentrenador_DD FIRST_RECORD entrenador.File_Number 1
End_Procedure

    Object oWebMainPanel is a cWebPanel
    Set piColumnCount to 12

    Object oentrenadorID is a cWebForm
        Entry_Item entrenador.ID
        Set piColumnSpan to 2
        Set piColumnIndex to 0
        Set peLabelPosition to lpTop
        Set psLabel to "ID"
    End_Object

    Object oentrenadorNombre is a cWebForm
        Entry_Item entrenador.Nombre
        Set piColumnSpan to 6
        Set piColumnIndex to 0
        Set peLabelPosition to lpTop
        Set psLabel to "Nombre"
    End_Object

    Object oentrenadorApellido is a cWebForm
        Entry_Item entrenador.Apellido
        Set piColumnSpan to 6
        Set piColumnIndex to 0
        Set peLabelPosition to lpTop
        Set psLabel to "Apellido"
    End_Object

    Object oentrenadorNacionalidad is a cWebForm
        Entry_Item entrenador.Nacionalidad
        Set piColumnSpan to 6
        Set piColumnIndex to 0
        Set peLabelPosition to lpTop
        Set psLabel to "Nacionalidad"
    End_Object

    Object oentrenadorEquipoID is a cWebForm
        Entry_Item entrenador.EquipoID
        Set piColumnSpan to 4
        Set piColumnIndex to 0
        Set peLabelPosition to lpTop
        Set psLabel to "Equipo"
    End_Object

End_Object

End_Object 
