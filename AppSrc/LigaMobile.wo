// C:\DataFlex Projects\FutbolWebbApp\AppSrc\LigaMobile.wo
// LigaMobile
//

Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg

Use cligaDataDictionary.dd
Use cequipoDataDictionary.dd
Use cWebButton.pkg
Use cWebGrid.pkg
Use cWebColumn.pkg

Register_Object oEquipoSelect

Object oLigaMobile is a cWebView
    Set piColumnCount to 12
    Set psCaption to "LigaMobile"
    Set piWidth to 700

    Object oliga_DD is a cligaDataDictionary
    End_Object 

    Object oequipo_DD is a cequipoDataDictionary
        Set Constrain_file to liga.File_number
        Set DDO_Server to oliga_DD
    End_Object

    Set Main_DD To oliga_DD
    Set Server  to oliga_DD
    
    Procedure OnShow
        Forward Send OnShow
        Send Request_Find of oliga_DD FIRST_RECORD liga.File_Number 1
    End_Procedure


    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oligaID is a cWebForm
            Entry_Item liga.ID
            Set piColumnSpan to 2
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "ID"
            Set psAutoComplete to "on"
            Set Auto_Fill_State to True
        End_Object 

        Object oligaNombre is a cWebForm
            Entry_Item liga.Nombre
            Set piColumnSpan to 12
            Set piColumnIndex to 0
            Set peLabelPosition to lpTop
            Set psLabel to "Nombre"
        End_Object 

        Object oWebGrid1 is a cWebGrid
            Set Server to oequipo_DD
            
            Object oWebColumn2 is a cWebColumn
                Entry_Item equipo.ID
                Set psCaption to "ID"
                Set piWidth to 50
            End_Object
            
            Object oWebColumn1 is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Equipo"
                Set piWidth to 50
            End_Object
        End_Object

        
    End_Object 

End_Object 
